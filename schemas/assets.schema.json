{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets.schema.json",
  "title": "assets_manifest.json",
  "type": "object",
  "required": [
    "schema_version",
    "dry_run",
    "provider_order",
    "assets",
    "scenes",
    "missing_scenes",
    "visual_support",
    "provider_attempts",
    "provider_errors",
    "warnings"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "dry_run": {"type": "boolean"},
    "visual_mode": {"type": "string"},
    "provider_order": {"type": "array", "items": {"type": "string"}},
    "routing_decisions": {"type": "array"},
    "assets": {"type": "array", "items": {"type": "object"}},
    "scenes": {"type": "array", "items": {"type": "object"}},
    "missing_scenes": {"type": "array", "items": {"type": "object"}},
    "visual_support": {"type": "object"},
    "completion": {"type": "object"},
    "continuity": {"type": "object"},
    "provider_attempts": {"type": "array"},
    "provider_errors": {"type": "array"},
    "visual_review": {"type": "object"},
    "semantic_visual": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
