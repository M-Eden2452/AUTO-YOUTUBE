{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice.schema.json",
  "title": "voice_manifest.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "voice_stage_status",
    "project_id",
    "job_id",
    "localization",
    "language",
    "provider",
    "voice_profile",
    "approval",
    "scenes",
    "narration",
    "errors",
    "warnings",
    "audio_path",
    "paid_call_performed"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string"},
    "voice_stage_status": {"type": "string"},
    "project_id": {"type": "string"},
    "job_id": {"type": "string"},
    "channel_id": {"type": "string"},
    "localization": {"type": "string"},
    "language": {"type": "string"},
    "provider": {"type": "string"},
    "voice_profile": {"type": "string"},
    "approval": {"type": ["object", "null"]},
    "scenes": {"type": "array", "items": {"type": "object"}},
    "narration": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "audio_path": {"type": "string"},
    "paid_call_performed": {"type": "boolean"}
  },
  "additionalProperties": true
}
