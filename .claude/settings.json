{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "WebFetch",
      "WebSearch",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(del /s *)",
      "Bash(rd /s *)",
      "Bash(Remove-Item -Recurse *)",
      "Bash(Remove-Item * -Recurse *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Write(./secrets/**)",
      "Write(./**/secrets/**)",
      "Edit(./secrets/**)",
      "Edit(./**/secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/credentials/**)",
      "Write(./credentials/**)",
      "Write(./**/credentials/**)",
      "Edit(./credentials/**)",
      "Edit(./**/credentials/**)",
      "Read(./*.pem)",
      "Read(./**/*.pem)",
      "Write(./*.pem)",
      "Write(./**/*.pem)",
      "Edit(./*.pem)",
      "Edit(./**/*.pem)",
      "Read(./*.key)",
      "Read(./**/*.key)",
      "Write(./*.key)",
      "Write(./**/*.key)",
      "Edit(./*.key)",
      "Edit(./**/*.key)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(*media-library migrate*--apply*)"
    ]
  }
}
