    {
      "application_id": "content_creator",
      "display_name": "Создание контента",
      "description": "Создание нового видео из темы, сценария, текста или ссылки: сценарий, подбор визуала, озвучка и финальный рендер.",
      "supported_input_types": [
        "topic",
