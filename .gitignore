venv/
MOSS_TTS_Nano/
.env
# Sensitive environment files, by exact name. A blanket `.env.*` is deliberately
# not used: it would also swallow the tracked, secret-free `.env.example`, and
# `!.env.example` below would then have to fight it. These names are kept in
# step with SECRET_ENV_NAMES in tools/qa/check_agent_docs.py, which fails if one
# of them is only excluded by a per-machine ignore file instead of this one.
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.test
.env.test.local
.env.bak
.env.backup
.env.old
.env.save
outputs/*.mp4
outputs/**/*.mp4
outputs/**/*.png
outputs/*.mov
outputs/**/*.mov
outputs/*.wav
outputs/**/*.wav
outputs/*.mp3
outputs/**/*.mp3
outputs/*.flac
outputs/**/*.flac
outputs/*.opus
outputs/**/*.opus
outputs/*.m4a
outputs/**/*.m4a
outputs/*.aac
outputs/**/*.aac
outputs/*.txt
outputs/**/*.txt
outputs/**/*.json
outputs/tts_tests/
outputs/*TEMP*
outputs/**/*TEMP*
outputs/render_temp/
outputs/**/render_temp/
/projects/
anime_factory/episodes/*
!anime_factory/episodes/.gitkeep
# Root-anchored (leading slash) so this rule never matches a same-named
# directory nested elsewhere in the tree - see the /projects/ rule above,
# which had exactly that bug before it was anchored. Confirmed (S1-Light)
# to hold no Python code: this is local experiment data and stock previews.
/project_solar_vs_nuclear/
assets/*
!assets/library/
assets/library/videos/
assets/library/images/
assets/library/music/
assets/library/thumbnails/
assets/library/metadata/media_index.json
!assets/library/metadata/
!assets/library/metadata/media_index.example.json
assets/cache/
music/*
# Только корневая выходная папка. Без ведущего слэша шаблон совпадал с любой
# директорией "subtitles" на любом уровне - в том числе с исходниками
# src/subtitles/ (движок субтитров, этап Q3). Выходные субтитры проектов и так
# не попадают в историю: /projects/ игнорируется целиком.
/subtitles/
__pycache__/
*.pyc
*.mp4
*.mov
*.wav
*.mp3
!.env.example
!assets/
!assets/images/
assets/images/*
!assets/images/.gitkeep
!assets/voice_samples/
assets/voice_samples/*
!assets/voice_samples/README.md
!assets/broll/
assets/broll/
!assets/broll/.gitkeep
!music/
music/*.mp3
!music/.gitkeep
manual_assets/**/*.mp4
manual_assets/**/*.mov
manual_assets/**/*.wav
manual_assets/**/*.mp3
manual_assets/**/*.m4a
manual_assets/**/*.aac
manual_assets/**/*.png
manual_assets/**/*.jpg
manual_assets/**/*.jpeg
manual_assets/**/*.webp
!manual_assets/**/*.svg
!manual_assets/**/.gitkeep

# Local agent permissions are machine-specific and must never enter the repository.
/.claude/settings.local.json

# Codex remote-session attachments are machine-local scratch, never repository content.
/.codex-remote-attachments/
