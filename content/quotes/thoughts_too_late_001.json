  "scenes": [
    {
      "scene_id": "intro_001",
      "type": "intro",
      "duration": 14,
      "screen_text": "Большинство людей не замечают,\nкак проходит их жизнь.\n\nПока однажды\nне становится слишком поздно.",
      "author": "",
